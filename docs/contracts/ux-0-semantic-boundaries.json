{
  "schemaVersion": 3,
  "scope": "NAPMS working runtime UI only; no fictional frontend collections",
  "runtime": {
    "sourceOfTruth": "FastAPI/SQLite",
    "forbiddenRoutes": [
      "/prototype"
    ],
    "reset": "schema-only, all user tables empty"
  },
  "realNavigation": {
    "entries": [
      {
        "group": "Бизнес-контекст",
        "title": "Бизнес-процессы",
        "path": "/business-processes"
      },
      {
        "group": "Каталоги",
        "title": "Ресурсы",
        "path": "/resources"
      },
      {
        "group": "Каталоги",
        "title": "Профили приложений",
        "path": "/applications"
      },
      {
        "group": "Каталоги",
        "title": "Развёрнутые компоненты",
        "path": "/deployments"
      },
      {
        "group": "Управление доступом",
        "title": "Заявки на доступ",
        "path": "/access-requests"
      },
      {
        "group": "Управление доступом",
        "title": "Правила политики",
        "path": "/policy-rules"
      }
    ],
    "contextualRoutes": {
      "ConnectivityNeed": "/business-processes/{processId}?tab=needs",
      "PolicyRule": "/policy-rules/{ruleId}"
    }
  },
  "semanticInvariants": [
    "AccessRequest PENDING/ALLOWED/DENIED is separate from PolicyRule ACTIVE/INACTIVE",
    "InteractionRevision is immutable once published",
    "DENIED does not create a PolicyRule"
  ]
}
