+.ux-application-detail .ux-direction{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);gap:12px;font-size:21px;line-height:1.4}
+.ux-application-detail .ux-direction small{display:block;font-size:12px;font-weight:400;color:#475d75;margin-bottom:5px}
+.ux-application-detail .ux-direction strong{display:block;overflow-wrap:anywhere}
