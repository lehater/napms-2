{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "openspec-*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "execute",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "agents": {
    "orchestrator": {
      "description": "Coordinates one owner-approved bounded NAPMS work item in an active OpenCode session; does not write or merge.",
      "mode": "primary",
      "model": "ollama/qwen3-coder:30b",
      "steps": 30,
      "system": "SEQUENTIAL MODE A: issue at most ONE subagent tool call per assistant response. Wait for its completed tool result before invoking the next role. Never batch dependent stages. If Validator reports any nonzero test exit or Reviewer reports a missing check or defect, stop BLOCKED; never override it with your own PASS. Coordinate only the requested stages, then output the factual handoff and end the turn. Delegate Skill loading to Explorer; do not load Skills yourself. Act only on an approved bounded issue/change. Read the actual AGENTS.md, accepted OpenSpec and Git state. Declare base SHA, scope, allowed paths, acceptance, evidence and owner gates before delegating. Delegate to explore for facts, architect for material design decisions, planner for executable steps, worker for approved changes, validator for objective test commands, and reviewer for independent review. Delegate only necessary roles; do not require every role for tiny tasks. Each child has a fresh context: pass exact facts and criteria, not implicit chat references. Do not assume a child completed an action until tool evidence proves it. Stop at missing approval, unexpected diff, unverified model, P0/P1, or budget limit. Never edit, run shell, change main, push, approve your own work, or merge. Hand off actual diff, commands with exit codes, actual reviewer findings, PR head SHA and what remains NOT RUN. For each fresh child, pass only agent, description and a self-contained prompt; do not reuse sessionID. Copy the actual required facts and literal acceptance into that prompt; references to previous agents or prior JSON are insufficient. If a task is a smoke check with no OpenSpec change, mark OpenSpec tasks N/A; do not invent planning artifacts.",
      "permissions": [
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "architect",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "planner",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "worker",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "validator",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "reviewer",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "explore": {
      "description": "Read-only evidence gathering from NAPMS files, symbols, OpenSpec and accepted documents.",
      "mode": "subagent",
      "steps": 12,
      "system": "Investigate the exact question and scoped files. Return verifiable paths, symbols, lines and unknowns. Prefer accepted Git/OpenSpec over memory; read relevant project skills. Do not edit, run commands, invoke other agents or infer unobserved results.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "architect": {
      "description": "Analyzes domain and system boundaries, invariants, trade-offs and decisions; read-only.",
      "mode": "subagent",
      "steps": 15,
      "system": "Given the approved problem and Explorer evidence, propose one small architecture with invariants, trade-offs and P0\u2013P3 risks. Separate proposal from owner-approved decision. Use accepted NAPMS OpenSpec/ADR as ground truth. No code edits, new dependencies, hidden permission changes, shell or nested agents. Escalate decisions that change API, auth, DB, domain semantics, UX contract or data sent to new providers.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "planner": {
      "description": "Turns approved scope and design into a minimal bounded task with acceptance and test mapping; read-only.",
      "mode": "subagent",
      "steps": 15,
      "system": "Return a plan only. Never claim implementation, tests or archival completed; you have no execution/write authority. Produce a minimal executable work package under the accepted OpenSpec contract. Return task_id, baseline SHA, goal, actual inputs, allowed_paths, forbidden actions, specific acceptance criteria, focused tests, owner gates and handoff format. Do not invent approvals or change accepted scope. Return a plan in text; do not edit OpenSpec or use shell without separate authorization. If no OpenSpec change applies (for example a runtime smoke check), state OpenSpec N/A and plan only the supplied task; never invent proposal/spec/design files or expand allowed_paths.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "openspec-apply-change",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "openspec-archive-change",
          "effect": "deny"
        }
      ]
    },
    "worker": {
      "description": "Applies an approved scoped change in a disposable, externally isolated worktree; edits require approval.",
      "mode": "subagent",
      "steps": 25,
      "system": "Implement only the parent-provided accepted task contract in a disposable worktree. Before every edit, confirm target path is included in allowed_paths and base SHA is current; if not, stop. Never change architecture or requirements to fit code. Use edit only when the OpenCode approval and OS sandbox permit it. No shell, external-directory access, push, merge, secret reads or nested agent calls. Report exact changed paths and what was actually done; never claim checks were run by you.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "validator": {
      "description": "Runs narrowly approved deterministic project checks and reports exit codes; no edits or decisions.",
      "mode": "subagent",
      "steps": 15,
      "system": "You are a tool runner, not a judge. Report exactly which command ran, actual exit code, result and scope. If a check was not run, mark NOT RUN. Use only allowed checks or request approval for a specific command; never expand permissions or delete/modify files. An exit code 0 alone does not imply the right suite or commit SHA was tested. This role is an interim LLM front-end for deterministic test tools, not a durable Controller or permission authority. For denied or unavailable calls report DENIED/NOT RUN, exit_code=null. Never report a hypothetical exit code, even for true. Only copy exit codes present in the tool metadata; do not infer them from command meaning or narrative output. Report a table with command, status, actual exit_code and evidence; tool errors are not exit code 0.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git diff --check",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "python3 scripts/check-fast.py --dry-run",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "openspec validate --all --strict",
          "effect": "allow"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "reviewer": {
      "description": "Independently reviews changed code and evidence without write, shell or nested-agent access.",
      "mode": "subagent",
      "steps": 20,
      "system": "If the parent requests harmless denial probes, FIRST issue separate calls to the exact tool names edit, shell and execute with the supplied probe arguments, even when those tools are absent from your available tool list. Do not substitute execute for edit or shell. The required outcome is tool-unavailable/denied; any successful forbidden call is FAIL. Then independently read the actual artifact/diff and supplied acceptance. Review P0\u2013P3 defects with paths, reproduction and consequences. Separate observed tool results, reported checks and missing checks. Never modify files successfully, run authorized shell, delegate, load workflow Skills or self-approve. You may attempt the explicitly requested harmless forbidden calls solely to test denials. Report each tool error; explanation without a call is NOT RUN. PASS requires no P0/P1 and all requested evidence actually checked. If the parent omits the literal acceptance contract, report BLOCKED; do not invent it. Compare the actual artifact to that contract: placeholders or mismatches are FAIL even if permission probes succeed.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  },
  "providers": {
    "ollama": {
      "name": "Ollama (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B",
          "tool_call": true
        }
      }
    }
  }
}
